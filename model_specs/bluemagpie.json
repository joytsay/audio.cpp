{
  "schema_version": 1,
  "family": "bluemagpie",
  "display_name": "BlueMagpie-TTS",
  "description": "Taiwanese Mandarin and mixed English TTS using Barbet + AudioVAE, 48 kHz output, speaker-reference cloning (no transcript), and streaming.",
  "category": "tts",
  "status": "supported",
  "tasks": [
    "tts",
    "clone"
  ],
  "modes": [
    "offline",
    "streaming"
  ],
  "languages": [
    "zh",
    "en"
  ],
  "capabilities": {
    "clone": [
      "speaker_reference"
    ]
  },
  "dependencies": [],
  "options": {
    "request": [
      {
        "name": "seed",
        "type": "int",
        "description": "Flow noise seed.",
        "default": 1234,
        "min": 0,
        "max": 2147483647,
        "required": false
      },
      {
        "name": "num_inference_steps",
        "type": "int",
        "description": "CFM sampling steps.",
        "default": 10,
        "min": 1,
        "max": 100,
        "required": false
      },
      {
        "name": "guidance_scale",
        "type": "float",
        "description": "CFM classifier-free guidance.",
        "default": 2,
        "min": 0,
        "max": 20,
        "required": false
      },
      {
        "name": "stream_chunk_ms",
        "type": "int",
        "description": "Audio chunk duration while generation continues.",
        "default": 320,
        "min": 40,
        "max": 5000,
        "required": false
      },
      {
        "name": "segment_bytes",
        "type": "int",
        "description": "Sentence-aware UTF-8 segment budget; 0 disables segmentation.",
        "default": 240,
        "min": 0,
        "max": 4096,
        "required": false
      }
    ],
    "session": [
      {
        "name": "max_frames",
        "type": "int",
        "description": "Safety cap on generated latent patches per segment.",
        "default": 512,
        "min": 1,
        "max": 4096,
        "required": false
      },
      {
        "name": "worker_path",
        "type": "path",
        "description": "Override the bundled BlueMagpie helper executable.",
        "required": false
      }
    ],
    "load": []
  },
  "runtime": {
    "tags": [
      "gguf",
      "stream"
    ]
  },
  "ui": {
    "recommended_package": "bluemagpie_1b_q8_0",
    "tags": [
      "TTS",
      "Clone",
      "GGUF",
      "Stream"
    ],
    "docs": [
      "docs/models/bluemagpie.md"
    ]
  },
  "package_defaults": {
    "download": {
      "kind": "huggingface_snapshot",
      "repo": "BricksDisplay/BlueMagpie-TTS-GGUF",
      "revision": "main",
      "gated": false,
      "file_sources": {
        "embedding_model.ckpt": {
          "repo": "speechbrain/spkrec-ecapa-voxceleb",
          "path": "embedding_model.ckpt",
          "revision": "main"
        }
      }
    }
  },
  "packages": [
    {
      "id": "bluemagpie_1b_q8_0",
      "display_name": "BlueMagpie 1B Q8_0 + AudioVAE Q8_0",
      "default": true,
      "format": "gguf",
      "precision": "q8_0",
      "target_directory": "BlueMagpie-TTS-Q8_0",
      "files": [
        "BlueMagpie-Barbet-1B-q8_0.gguf",
        "BlueMagpie-AudioVAE-q8_0.gguf",
        "embedding_model.ckpt"
      ]
    },
    {
      "id": "bluemagpie_1b_q4_k_m",
      "display_name": "BlueMagpie 1B Q4_K_M + AudioVAE Q8_0",
      "default": false,
      "format": "gguf",
      "precision": "q4_k_m",
      "target_directory": "BlueMagpie-TTS-Q4_K_M",
      "files": [
        "BlueMagpie-Barbet-1B-q4_k_m.gguf",
        "BlueMagpie-AudioVAE-q8_0.gguf",
        "embedding_model.ckpt"
      ]
    },
    {
      "id": "bluemagpie_1b_q5_k_m",
      "display_name": "BlueMagpie 1B Q5_K_M + AudioVAE Q8_0",
      "default": false,
      "format": "gguf",
      "precision": "q5_k_m",
      "target_directory": "BlueMagpie-TTS-Q5_K_M",
      "files": [
        "BlueMagpie-Barbet-1B-q5_k_m.gguf",
        "BlueMagpie-AudioVAE-q8_0.gguf",
        "embedding_model.ckpt"
      ]
    },
    {
      "id": "bluemagpie_1b_q6_k",
      "display_name": "BlueMagpie 1B Q6_K + AudioVAE Q8_0",
      "default": false,
      "format": "gguf",
      "precision": "q6_k",
      "target_directory": "BlueMagpie-TTS-Q6_K",
      "files": [
        "BlueMagpie-Barbet-1B-q6_k.gguf",
        "BlueMagpie-AudioVAE-q8_0.gguf",
        "embedding_model.ckpt"
      ]
    },
    {
      "id": "bluemagpie_1b_f16",
      "display_name": "BlueMagpie 1B F16 + AudioVAE Q8_0",
      "default": false,
      "format": "gguf",
      "precision": "f16",
      "target_directory": "BlueMagpie-TTS-F16",
      "files": [
        "BlueMagpie-Barbet-1B-f16.gguf",
        "BlueMagpie-AudioVAE-q8_0.gguf",
        "embedding_model.ckpt"
      ]
    }
  ],
  "sources": [
    {
      "format": "gguf",
      "roots": {
        "model": ".",
        "weights": "$gguf"
      },
      "tensors": {
        "backbone": "weights:",
        "audiovae": "model:BlueMagpie-AudioVAE-q8_0.gguf"
      }
    }
  ]
}
