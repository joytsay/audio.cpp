+TEST(hash_embedder_cjk_features) {
+    rag::dense::HashEmbedder e(512);
+    std::vector<std::string> in{"中控室機台", "中控室機台", "晶圓警報"};
+    auto result = e.embed(in);
+    REQUIRE(result.has_value());
+    REQUIRE(result->size() == 3);
+    const auto magnitude = [](const auto& vector) {
+        float sum = 0.0f;
+        for (float value : vector) sum += std::abs(value);
+        return sum;
+    };
+    CHECK(magnitude((*result)[0]) > 0.0f);
+    CHECK(std::abs(rag::dense::cosine((*result)[0], (*result)[1]) - 1.0f) < 1e-5f);
+    CHECK(rag::dense::cosine((*result)[0], (*result)[2]) < 0.99f);
+}
