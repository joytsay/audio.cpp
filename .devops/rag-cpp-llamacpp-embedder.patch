+std::optional<rag::dense::AnyEmbedder>
+llamacpp_embedder(const std::vector<std::string>& args) {
+    const auto port = std::stoul(opt(args, "--llamacpp-port", "0"));
+    if (!port) return std::nullopt;
+    rag::dense::LlamaCppConfig config;
+    config.host = opt(args, "--llamacpp-host", "127.0.0.1");
+    config.port = static_cast<std::uint16_t>(port);
+    config.path = opt(args, "--llamacpp-path", "/embedding");
+    config.concurrency = std::stoul(opt(args, "--llamacpp-concurrency", "1"));
+    return rag::dense::AnyEmbedder{rag::dense::LlamaCppEmbedder{std::move(config)}};
+}
+
+bool excluded(const std::vector<std::string>& args, const std::string& uri) {
+    const std::string basename = std::filesystem::path(uri).filename().string();
+    for (const auto& arg : args) {
+        constexpr std::string_view prefix = "--exclude=";
+        if (arg.rfind(prefix, 0) == 0 && arg.substr(prefix.size()) == basename)
+            return true;
+    }
+    return false;
+}
