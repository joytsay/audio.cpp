# Copy this file to .env.sip. Edit the required account and model settings.
# Run ./build-sip/exampleSIP from this directory. Do not source this file.
# Exported shell variables take priority. CLI account arguments take priority.
# Values are literal. $VARIABLE, ${VARIABLE}, ~ and shell commands are not expanded.
# Relative file paths start at this file's directory.

SIP_ACCOUNT=sip:YOUR_USER@sip.example.com
SIP_PROXY=sip:sip.example.com:5060
# Use listen to answer one call, or a destination such as sip:OTHER_USER@sip.example.com.
SIP_TARGET=listen
SIP_SECRET='REPLACE_WITH_TEST_ACCOUNT_PASSWORD'
SIP_AUTHUSER=
SIP_CODEC=PCMU
# RTP telephone events (rtp) or SIP INFO (info).
SIP_DTMF_MODE=rtp
# Optional bind address, interface and RTP port range.
SIP_LISTEN=
SIP_INTERFACE=
SIP_RTP_PORTS=10000-20000
# Empty uses the module directory detected at build time.
BARESIP_MODULE_PATH=

# VAD, STT and TTS services. Models must be registered on this server.
AUDIOCPP_URL=http://192.168.5.151:8081
VAD_MODEL=silero-vad
STT_MODEL=qwen3-asr
STT_LANGUAGE=
STT_HOTWORDS='Technical terms: ASML, FOUP, AMHS, 奇偶科技, 中控室'
# Optional UTF-8 file or single-column hotword.csv; takes priority over STT_HOTWORDS.
STT_HOTWORDS_FILE=

# OpenAI-compatible LLM base URL. Include /v1.
LLM_URL=http://192.168.5.151:8082/v1
LLM_MODEL=REPLACE_WITH_REGISTERED_LLM_ID
LLM_API_KEY=

# audio.cpp RAG proxy. Use the same indexed knowledge as the web pipeline.
RAG_URL=http://192.168.5.151:8081/v1/rag
# Optional local UTF-8 prompt file. Empty means the built-in telephone prompt.
SYSTEM_PROMPT_FILE=

# Reply voice: lingCL or WangSG.
TTS_MODEL=zipvoice
TTS_VOICE=lingCL
IVRTTS_VOICE_DIR=voices
