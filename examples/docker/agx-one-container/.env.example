# JetPack 6.2.x / L4T R36.4.x example for Jetson AGX Orin.
CUDA_VERSION=12.6.3
UBUNTU_VERSION=22.04
GCC_VERSION=11
BUILD_JOBS=2
AUDIOCPP_MODELS=all
RAGCPP_REF=748bbd4895e0939857ffcc10276da1c91f20b439
CUDA_ARCH=87-real
BASE_CUDA_DEV_CONTAINER=docker.io/nvidia/cuda:12.6.3-devel-ubuntu22.04
BASE_CUDA_RUN_CONTAINER=nvcr.io/nvidia/l4t-cuda:12.6.11-runtime

# SIP and coturn are included in this Compose project (Linux host networking).
# Run the sip-setup service on the AGX to detect its address and update .env.
# It detects the local IP and generates a password when this placeholder is used.
COTURN_IMAGE=coturn/coturn:4.18.0-r0-alpine
# IP assigned to the machine running the coturn container.
COTURN_LISTEN_IP=192.168.5.151
# Empty uses COTURN_LISTEN_IP.
COTURN_RELAY_IP=
COTURN_PORT=3478
COTURN_REALM=ivrtts
COTURN_USERNAME=ivrtts
COTURN_PASSWORD='REPLACE_WITH_TURN_PASSWORD'
# If coturn is behind NAT: public_ip/private_ip. Otherwise leave empty.
# Forward UDP/TCP 3478 and UDP 49160-49200 with identical external/internal ports.
COTURN_EXTERNAL_IP=
COTURN_MIN_PORT=49160
COTURN_MAX_PORT=49200
# The SIP service reads the TURN URL and credentials directly from this file.
# Use a public hostname/IP when the SIP peer is outside the LAN.
COTURN_URL=turn:192.168.5.151:3478?transport=udp

# Set to sip to start the telephone pipeline and coturn with docker compose up.
# Leave empty to run only the web/audio services.
COMPOSE_PROFILES=
SIP_ACCOUNT=
SIP_PROXY=
SIP_SECRET='REPLACE_WITH_TEST_ACCOUNT_PASSWORD'
SIP_AUTHUSER=
SIP_TARGET=listen
# Greeting text. Empty disables it; by default the caller presses # to start it.
SIP_GREETING='歡迎來電期偶科技 請問我可以怎麼服務您'
# 1 waits for the caller to press #; 0 starts the greeting automatically.
SIP_WAIT_FOR_MEDIA=1
SIP_CODEC=PCMU
SIP_DTMF_MODE=rtp
# Optional interface name/address and signaling bind address on the AGX.
SIP_INTERFACE=
SIP_LISTEN=
SIP_RTP_PORTS=10000-20000
SIP_LLM_MODEL=bartowski/Qwen2.5-3B-Instruct-GGUF:Q4_K_M
SIP_VAD_MODEL=silero-vad
SIP_STT_MODEL=qwen3-asr
SIP_STT_LANGUAGE=
SIP_TTS_MODEL=zipvoice
SIP_TTS_VOICE=lingCL
LLM_API_KEY=
# Set these to the host user's IDs when running sip-setup.
LOCAL_UID=1000
LOCAL_GID=1000
