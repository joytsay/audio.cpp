    {
      "id": "scenario-1-test-input",
      "name": "Scenario 1 test input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        -120
      ],
      "parameters": {
        "jsCode": "// Set turn to 1, 2, or 3 to test that stage without an IVR request.\nconst turn = 1;\nconst turns = [\n  {\n    \"text\": \"我要回報工單，2026年6月2日下午14:00台積電F15P1/2_ME VFD備品與維修。\\nF15P1H4K-GEX-EF-03 五年一維，更換強排FAN 2個、間面FAN 6個。\\nF15P1H4K-GEX-EF-04 五年一維，更換強排FAN 2個、間面FAN 4個。\",\n    \"expected\": \"F15P1H4K-GEX-EF-03 五年一維，更換強排FAN 2個、間面FAN 6個。\\n\\nF15P1H4K-GEX-EF-04 五年一維，更換強排FAN 2個、間面FAN 4個。\\n\\n以上是否正確。\"\n  },\n  {\n    \"text\": \"正確，請幫我備註\\n20BD156AOANNANCU\\nSN：14778725 製造日期：2010年12月3日 電容值：6460MF\\n20BD156AOANNANCU\\nSN：14865412 製造日期：2010年12月15日 電容值：6780MF\",\n    \"expected\": \"20BD156AOANNANCU有兩個，分別為\\n\\nSN：14778725 製造日期：2010年12月3日 電容值：6460MF\\n\\nSN：14865412 製造日期：2010年12月15日 電容值：6780MF\\n\\n以上是否正確。\"\n  },\n  {\n    \"text\": \"正確，起機測試正常。\",\n    \"expected\": \"好的，工單：F15P1/2_ME VFD備品與維修，已輸入完成，謝謝。\"\n  }\n];\nif (![1, 2, 3].includes(turn)) throw new Error(\"turn must be 1, 2, or 3\");\nconst messages = [];\nfor (let i = 0; i < turn - 1; i++) {\n  messages.push({role:\"user\", content:turns[i].text}, {role:\"assistant\", content:turns[i].expected});\n}\nmessages.push({role:\"user\", content:turns[turn - 1].text});\nreturn [{json:{body:{sessionId:\"scenario-1-manual-test\", model:\"bartowski/Qwen2.5-3B-Instruct-GGUF:Q4_K_M\", text:turns[turn - 1].text, messages}}}];"
      }
