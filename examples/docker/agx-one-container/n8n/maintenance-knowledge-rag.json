{
  "id": "ivrMaintenanceKnowledge",
  "name": "IVR Maintenance Knowledge · RAG Tool",
  "nodes": [
    {
      "id": "rag-tool-input",
      "name": "RAG tool input",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "inputSource": "workflowInputs",
        "workflowInputs": {
          "values": [
            {
              "name": "query",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "prepare-guidance",
      "name": "Prepare guidance",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "jsCode": "const query = $('RAG tool input').first().json.query;\nconst documents = $input.first().json.documents;\nif (typeof query !== 'string' || !query.trim()) throw new Error('A guidance query is required');\nif (!Array.isArray(documents) || !documents.length) throw new Error('Knowledge file extraction returned no documents');\nconst expected = ['prompt.csv','情境模擬_20261105.docx','CSD資料庫.xlsx','(備品維修)PY252-0059-工單-20260602-2工-CL、JC.pdf'];\nfor (const source of expected) if (!documents.some(doc => doc.source === source)) throw new Error('Missing knowledge source: ' + source);\nconst sources = documents.map(({text, ...metadata}) => metadata);\nconst knowledge = documents.map(doc => {\n  if (typeof doc.text !== 'string' || !doc.text.trim()) throw new Error('Empty source: ' + doc.source);\n  const header = '【來源：' + doc.source + (doc.sheet ? '；工作表：' + doc.sheet : '') + '；類型：' + doc.kind + '；擷取：' + doc.extraction + '】';\n  return doc.text.split(/\\n\\s*\\n/).filter(Boolean).map(paragraph => header + '\\n' + paragraph).join('\\n\\n');\n}).join('\\n\\n');\nreturn [{json:{query,knowledge,sources}}];"
      }
    },
    {
      "id": "seed-simple-vector-store",
      "name": "Seed Simple Vector Store",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreInMemory",
      "typeVersion": 1.2,
      "position": [
        940,
        0
      ],
      "parameters": {
        "mode": "insert",
        "memoryKey": {
          "__rl": true,
          "mode": "id",
          "value": "ivr-maintenance-guidance"
        },
        "clearStore": true
      }
    },
    {
      "id": "default-document-loader",
      "name": "Default Document Loader",
      "type": "@n8n/n8n-nodes-langchain.documentDefaultDataLoader",
      "typeVersion": 1.1,
      "position": [
        420,
        240
      ],
      "parameters": {
        "dataType": "json",
        "jsonMode": "expressionData",
        "jsonData": "={{ $('Prepare guidance').first().json.knowledge }}",
        "textSplittingMode": "custom",
        "options": {}
      }
    },
    {
      "id": "recursive-text-splitter",
      "name": "Recursive Text Splitter",
      "type": "@n8n/n8n-nodes-langchain.textSplitterRecursiveCharacterTextSplitter",
      "typeVersion": 1,
      "position": [
        400,
        460
      ],
      "parameters": {
        "chunkSize": 450,
        "chunkOverlap": 80,
        "options": {}
      }
    },
    {
      "id": "local-embeddings",
      "name": "Local Embeddings",
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1.1,
      "position": [
        700,
        460
      ],
      "parameters": {
        "model": "Qwen/Qwen3-Embedding-0.6B-GGUF:Q8_0",
        "options": {
          "baseURL": "http://192.168.5.151:8084/v1",
          "batchSize": 8,
          "encodingFormat": "float"
        }
      },
      "credentials": {
        "openAiApi": {
          "id": "configure-local-embeddings",
          "name": "IVR local embeddings"
        }
      }
    },
    {
      "id": "retrieve-guidance",
      "name": "Retrieve guidance",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreInMemory",
      "typeVersion": 1.2,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "mode": "load",
        "memoryKey": {
          "__rl": true,
          "mode": "id",
          "value": "ivr-maintenance-guidance"
        },
        "prompt": "={{ $('Prepare guidance').first().json.query }}",
        "topK": 4,
        "options": {}
      },
      "executeOnce": true
    },
    {
      "id": "return-guidance",
      "name": "Return guidance",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1580,
        0
      ],
      "parameters": {
        "jsCode": "const passages = $input.all().map(item => item.json.document?.pageContent).filter(Boolean);\nif (!passages.length) throw new Error('No knowledge passages retrieved');\nreturn [{json:{passages,sources:$('Prepare guidance').first().json.sources,scope:'prompt.csv rules; DOCX scenario examples (not actual records); all XLSX worksheets; PDF text/OCR (verify OCR codes and quantities). These passages may be partial; use list_work_orders for the complete dispatch list.'}}];"
      }
    },
    {
      "id": "load-knowledge-files",
      "name": "Load knowledge files",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "url": "http://knowledge:8085/documents",
        "options": {
          "timeout": 240000
        }
      }
    }
  ],
