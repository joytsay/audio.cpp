{
  "id": "ivrMaintenanceKnowledge",
  "name": "GeoVision · RAG",
  "nodes": [
    {
      "id": "rag-tool-input",
      "name": "RAG tool input",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        250,
        0
      ],
      "parameters": {
        "inputSource": "workflowInputs",
        "workflowInputs": {
          "values": [
            {
              "name": "query",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "prepare-guidance",
      "name": "Prepare guidance",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        0
      ],
      "parameters": {
        "jsCode": "const query = $('Validate query').first().json.query;\nconst documents = $input.first().json.documents;\nconst result = $input.first().json.result;\nif (typeof query !== 'string' || !query.trim()) throw new Error('A guidance query is required');\nif (!Array.isArray(documents) || !documents.length) throw new Error('Knowledge file extraction returned no documents');\nconst expected = result ? ['CSD資料庫.xlsx'] : ['prompt.csv','情境模擬_20261105.docx','CSD資料庫.xlsx','(備品維修)PY252-0059-工單-20260602-2工-CL、JC.pdf'];\nfor (const source of expected) if (!documents.some(doc => doc.source === source)) throw new Error('Missing knowledge source: ' + source);\nconst sources = documents.map(({text, ...metadata}) => metadata);\nconst knowledge = documents.map(doc => {\n  if (typeof doc.text !== 'string' || !doc.text.trim()) throw new Error('Empty source: ' + doc.source);\n  const header = '【來源：' + doc.source + (doc.sheet ? '；工作表：' + doc.sheet : '') + '；類型：' + doc.kind + '；擷取：' + doc.extraction + '】';\n  return doc.text.split(/\\n\\s*\\n/).filter(Boolean).map(paragraph => header + '\\n' + paragraph).join('\\n\\n');\n}).join('\\n\\n');\nreturn [{json:{query,knowledge,sources,result}}];"
      }
    },
    {
      "id": "seed-simple-vector-store",
      "name": "Seed Simple Vector Store",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreInMemory",
      "typeVersion": 1.2,
      "position": [
        1280,
        0
      ],
      "parameters": {
        "mode": "insert",
        "memoryKey": {
          "__rl": true,
          "mode": "id",
          "value": "ivr-maintenance-guidance"
        },
        "clearStore": true
      }
    },
    {
      "id": "default-document-loader",
      "name": "Default Document Loader",
      "type": "@n8n/n8n-nodes-langchain.documentDefaultDataLoader",
      "typeVersion": 1.1,
      "position": [
        1230,
        300
      ],
      "parameters": {
        "dataType": "json",
        "jsonMode": "expressionData",
        "jsonData": "={{ $('Prepare guidance').first().json.knowledge }}",
        "textSplittingMode": "custom",
        "options": {}
      }
    },
    {
      "id": "recursive-text-splitter",
      "name": "Recursive Text Splitter",
      "type": "@n8n/n8n-nodes-langchain.textSplitterRecursiveCharacterTextSplitter",
      "typeVersion": 1,
      "position": [
        1130,
        540
      ],
      "parameters": {
        "chunkSize": 450,
        "chunkOverlap": 80,
        "options": {}
      }
    },
    {
      "id": "local-embeddings",
      "name": "Local Embeddings",
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1.1,
      "position": [
        1550,
        540
      ],
      "parameters": {
        "model": "Qwen/Qwen3-Embedding-0.6B-GGUF:Q8_0",
        "options": {
          "baseURL": "http://192.168.5.151:8084/v1",
          "batchSize": 8,
          "encodingFormat": "float"
        }
      },
      "credentials": {
        "openAiApi": {
          "id": "configure-local-embeddings",
          "name": "IVR local embeddings"
        }
      }
    },
    {
      "id": "retrieve-guidance",
      "name": "Retrieve guidance",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreInMemory",
      "typeVersion": 1.2,
      "position": [
        1610,
        0
      ],
      "parameters": {
        "mode": "load",
        "memoryKey": {
          "__rl": true,
          "mode": "id",
          "value": "ivr-maintenance-guidance"
        },
        "prompt": "={{ $('Prepare guidance').first().json.query }}",
        "topK": 4,
        "options": {}
      },
      "executeOnce": true
    },
    {
      "id": "return-guidance",
      "name": "Return guidance",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        0
      ],
      "parameters": {
        "jsCode": "const prepared = $('Prepare guidance').first().json;\nif (prepared.result) return [{json:{...prepared.result,sources:prepared.sources}}];\nconst passages = $input.all().map(item => item.json.document?.pageContent).filter(Boolean);\nif (!passages.length) throw new Error('No knowledge passages retrieved');\nreturn [{json:{passages,sources:$('Prepare guidance').first().json.sources,scope:'prompt.csv rules; DOCX scenario examples (not actual records); all XLSX worksheets; PDF text/OCR (verify OCR codes and quantities). These passages may be partial; do not claim a complete dispatch list from these passages.'}}];"
      }
    },
    {
      "id": "load-knowledge-files",
      "name": "Load knowledge files",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        750,
        0
      ],
      "parameters": {
        "url": "http://knowledge:8085/documents",
        "options": {
          "timeout": 240000
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "query",
              "value": "={{ $json.query }}"
            }
          ]
        }
      }
    },
    {
      "id": "manual-rag-test",
      "name": "Test RAG",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        -260
      ],
      "parameters": {}
    },
    {
      "id": "rag-test-query",
      "name": "Test query",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        250,
        -260
      ],
      "parameters": {
        "jsCode": "// Edit this text to test another retrieval question.\nreturn [{json:{query:'維修工單回報時，SN、製造日期與電容值要如何記錄？'}}];"
      }
    },
    {
      "id": "validate-rag-query",
      "name": "Validate query",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        0
      ],
      "parameters": {
        "jsCode": "const query = $input.first().json.query;\nif (typeof query !== 'string' || !query.trim()) throw new Error('缺少 query。手動測試請使用 Test RAG → Test query；MCP 呼叫請確認 lookup_maintenance_guidance 的 query 輸入。');\nreturn [{json:{query:query.trim()}}];"
      }
    }
  ],
