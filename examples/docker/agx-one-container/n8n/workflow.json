      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3910,
        2790
      ],
      "parameters": {
        "jsCode": "const request=$('Prepare document RAG').first().json;\nconst embedding=$input.first().json.body?.[0]?.embedding;\nconst vector=Array.isArray(embedding?.[0])?embedding[0]:embedding;\nif(!Array.isArray(vector)||vector.length!==request.dimensions||!vector.every(Number.isFinite))throw Error('Invalid question vector');\nconst visual=request.documents.filter(d=>d.kind==='image'||d.kind==='page').length;\nreturn [{json:{query:vector,filter:{must:[{has_id:request.ids}]},limit:Math.min(request.ids.length,5+Math.max(0,visual-2)),with_payload:true}}];"
      }
    },
