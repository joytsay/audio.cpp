    {
      "id": "document-rag-prepare",
      "name": "Prepare document RAG",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        300,
        2880
      ],
      "parameters": {
        "jsCode": "const input=$input.first().json.body;\nif(!input||!/^[a-f0-9]{64}$/.test(input.scope)||!/^ivr_documents_[a-f0-9]{16}$/.test(input.collection)||\n !Number.isInteger(input.dimensions)||input.dimensions<1||input.dimensions>16384||\n !Array.isArray(input.documents)||input.documents.length>2200||\n input.documents.some(d=>!d||!/^[a-f0-9]{8}-(?:[a-f0-9]{4}-){3}[a-f0-9]{12}$/.test(d.id)||!['text','table','image','page'].includes(d.kind))||\n (input.index!==true&&(typeof input.query!=='string'||!input.query.trim()||typeof input.query_prompt!=='string'||input.query_prompt.length>12000)))throw Error('Invalid document RAG request');\nconst simulation=input.simulation;\nif(simulation!==undefined){\n const text=(value,max)=>typeof value==='string'&&value.length<=max;\n if(simulation?.mode==='route'){\n  if(!Array.isArray(simulation.candidates)||!simulation.candidates.length||simulation.candidates.length>999||\n   simulation.candidates.some(item=>!Number.isInteger(item?.number)||item.number<1||item.number>999||!text(item.title,200)))\n   throw Error('Invalid scenario candidates');\n }else if(simulation?.mode==='dialogue'){\n  if(!text(simulation.title,200)||!text(simulation.example,2400)||!Array.isArray(simulation.history)||simulation.history.length>8||\n   simulation.history.some(item=>!['user','assistant'].includes(item?.role)||!text(item.content,1000)))\n   throw Error('Invalid scenario dialogue context');\n }else throw Error('Invalid simulation mode');\n}\nreturn [{json:{...input,ids:input.documents.map(d=>d.id)}}];"
      }
    },
