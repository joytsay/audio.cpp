      "parameters": {
        "jsCode": "const missing=$input.first().json.missing;\nconst scope=$('Prepare document RAG').first().json.scope;\nconst batches=[];\nlet text=[];\nfor(const {id,kind} of missing){\n if(kind==='image'||kind==='page')batches.push({scope,ids:[id]});\n else{\n  text.push(id);\n  if(text.length===8){batches.push({scope,ids:text});text=[];}\n }\n}\nif(text.length)batches.push({scope,ids:text});\nreturn batches.map(json=>({json}));"
      }
    },
