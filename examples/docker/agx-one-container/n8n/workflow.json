        "path": "ivr-agent",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "ivr-agent"
    },
    {
      "id": "ivr-read-work-orders-table",
      "name": "Read work orders · Data Table",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        520,
        160
      ],
      "alwaysOutputData": true,
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "work_orders"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": []
        },
        "returnAll": true
      }
