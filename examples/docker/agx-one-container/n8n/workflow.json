      "id": "document-rag-pick",
      "name": "Select ranked visual evidence",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4350,
        2790
      ],
      "parameters": {
        "jsCode": "const hits=$input.first().json.result?.points;\nif(!Array.isArray(hits))throw Error('Qdrant returned no ranked evidence');\nconst ids=[],scores=[];\nlet images=0;\nfor(const hit of hits){\n if(ids.length===5)break;\n const visual=['image','page'].includes(hit.payload?.kind);\n if(visual&&images===2)continue;\n if(visual)images++;\n ids.push(hit.id);scores.push(hit.score);\n}\nif(!ids.length)throw Error('Qdrant returned no matching documents for the active corpus');\nreturn [{json:{scope:$('Prepare document RAG').first().json.scope,ids,scores}}];"
      }
    },
