    {
      "id": "ivr-prepare-call-request",
      "name": "Add saved work orders",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        740,
        160
      ],
      "parameters": {
        "jsCode": "// The IVR engine answers questions about saved work orders from these rows.\nconst body=$('IVR Input').first().json.body??{};\nif(typeof body.text!=='string')return [{json:body}];\nconst text=value=>String(value??'');\nconst rows=$input.all().map(item=>item.json).filter(row=>row.id&&row.order_id)\n .sort((a,b)=>text(b.createdAt).localeCompare(text(a.createdAt))).slice(0,20)\n .map(row=>({order_id:text(row.order_id),reference_number:text(row.reference_number),dispatch_date:text(row.dispatch_date),\n  title:text(row.title),equipment_number:text(row.equipment_number),maintenance_items:text(row.maintenance_items),\n  notes:text(row.notes),test_result:text(row.test_result),saved_at:text(row.createdAt)}));\nreturn [{json:{...body,work_orders:rows}}];"
      }
    },
