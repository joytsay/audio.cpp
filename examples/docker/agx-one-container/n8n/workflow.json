    {
      "id": "document-rag-missing",
      "name": "Find missing document vectors",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        2780
      ],
      "parameters": {
        "jsCode": "const request=$('Prepare document RAG').first().json;\nconst response=$input.first().json;\nif(!Array.isArray(response.result))throw Error('Qdrant returned no point list');\nconst stored=new Set(response.result.map(point=>point.id));\nreturn [{json:{missing:request.documents.filter(d=>!stored.has(d.id))}}];"
      }
