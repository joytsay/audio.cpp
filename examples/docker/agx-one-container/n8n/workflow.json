      "position": [
        2790,
        2680
      ],
      "parameters": {
        "jsCode": "const prompts=$('Load multimodal embedding inputs').all();\nconst responses=$input.all();\nif(responses.length!==prompts.length)throw Error('Document embedding batch count differs');\nconst dimensions=$('Prepare document RAG').first().json.dimensions;\nreturn responses.map(({json},batch)=>{\n const {ids,payloads}=prompts[batch].json;\n const rows=json.body;\n if(!Array.isArray(rows)||rows.length!==ids.length)throw Error('Document embedding count differs');\n const seen=new Set();\n const points=rows.map(({index,embedding})=>{\n  const vector=Array.isArray(embedding?.[0])?embedding[0]:embedding;\n  if(!Number.isInteger(index)||index<0||index>=ids.length||seen.has(index)||\n   !Array.isArray(vector)||vector.length!==dimensions||!vector.every(Number.isFinite))throw Error('Invalid document vector');\n  seen.add(index);\n  return {id:ids[index],vector,payload:payloads[index]};\n });\n return {json:{points}};\n});"
      }
    },
