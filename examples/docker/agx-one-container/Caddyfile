{
	auto_https disable_redirects
	skip_install_trust
	# Match the working Realtime-Venus setup for clients connecting by IP.
	default_sni {$AUDIOCPP_HTTPS_HOST:192.168.5.151}
}

https://{$AUDIOCPP_HTTPS_HOST:192.168.5.151}:443 {
	tls internal

	# Browser SIP signaling to the local, host-networked Asterisk test PBX.
	handle /sip-ws {
		rewrite * /ws
		reverse_proxy host.docker.internal:8088
	}

	# Only production webhooks use this prefix. Open the editor on port 5678.
	handle /n8n/mcp/* {
		uri strip_prefix /n8n
		reverse_proxy n8n:5678 {
			flush_interval -1
		}
	}

	handle /n8n/webhook/* {
		uri strip_prefix /n8n
		reverse_proxy n8n:5678
	}

	# Keep llama.cpp requests on the same HTTPS origin, including router APIs.
	handle_path /llm/* {
		reverse_proxy voice-ai:8082
	}

	# The native server serves the embedded UI, audio API, uploads, and RAG.
	handle {
		reverse_proxy voice-ai:8081
	}
}
