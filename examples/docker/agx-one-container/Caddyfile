{
	auto_https disable_redirects
	skip_install_trust
	# Match the working Realtime-Venus setup for clients connecting by IP.
	default_sni {$AUDIOCPP_HTTPS_HOST:192.168.5.151}
}

# Shared UI, audio, LLM, workflow, and SIP routes for both interfaces.
(geovision) {
	# Browser SIP signaling to the local, host-networked Asterisk test PBX.
	handle /sip-ws {
		rewrite * /ws
		reverse_proxy host.docker.internal:8088
	}

	# Only production webhooks use this prefix. Open the editor on port 5678.
	handle /n8n/webhook/ivr-document-rag* {
		respond 404
	}

	handle /n8n/webhook/* {
		uri strip_prefix /n8n
		reverse_proxy n8n:5678
	}

	handle /ivr-simulation {
		reverse_proxy knowledge:8085
	}

	# Keep llama.cpp requests on the same HTTPS origin, including router APIs.
	handle_path /llm/* {
		reverse_proxy voice-ai:8082
	}

	handle /asr-postprocess/v1/chat/completions {
		uri strip_prefix /asr-postprocess
		reverse_proxy voice-ai:8089
	}

	@webui {
		method GET HEAD
		path / /index.html /_app/* /logo_cloud.svg
		file {
			root /srv/geovision
			try_files {path}index.html {path}
		}
	}
	handle @webui {
		@document path / /index.html
		header @document {
			Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
			Clear-Site-Data "\"cache\""
			Expires "0"
			Pragma "no-cache"
			Content-Security-Policy "default-src 'self' 'unsafe-inline' blob: data:; connect-src 'self' http://*:8082 http://*:8083; media-src 'self' blob: data:"
			X-Content-Type-Options "nosniff"
		}
		file_server {
			root /srv/geovision
		}
	}

	# The audio API, uploads, and RAG still use the native server.
	handle {
		reverse_proxy voice-ai:8081
	}
}

# Host 8082 maps to TLS 443 (demo); host 8084 maps to TLS 444 (full UI).
https://{$AUDIOCPP_HTTPS_HOST:192.168.5.151}:443, https://localhost:443, https://127.0.0.1:443, https://{$AUDIOCPP_HTTPS_HOST:192.168.5.151}:444, https://localhost:444, https://127.0.0.1:444 {
	tls internal
	import geovision
}

# HTTP demo and full interface share the same API/webhook gateway.
http://:8081, http://:8083 {
	import geovision
}
