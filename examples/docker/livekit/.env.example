# Linux ARM64 / Jetson: LiveKit/agent use host networking; Supabase uses a private bridge.
LIVEKIT_NODE_IP=192.168.5.151
LIVEKIT_PORT=7880
LIVEKIT_TCP_PORT=7881
LIVEKIT_UDP_PORT=7882
WEB_PORT=8090
# HTTPS browser client: https://LIVEKIT_NODE_IP:8093
LIVEKIT_HTTPS_PORT=8093
# Optional override. Default: wss://LIVEKIT_NODE_IP:LIVEKIT_HTTPS_PORT/livekit
LIVEKIT_PUBLIC_URL=
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Internal HTTP adapter binds loopback only. Choose an unused port.
ADAPTER_PORT=8095
AGENT_HEALTH_PORT=8096
# Base URLs include /v1. Existing inference containers must already be running.
STT_BASE_URL=http://127.0.0.1:8081/v1
STT_MODEL=qwen3-asr
STT_LANGUAGE=zh
STT_API_KEY=local
USE_HOTWORDS=0
TTS_BASE_URL=http://127.0.0.1:8081/v1
TTS_MODEL=zipvoice
TTS_VOICE=lingCL
TTS_API_KEY=local
# Presets: lingCL or WangSG; others pass through the voice field.
CHINESE_NUMBERS=1
LLM_BASE_URL=http://127.0.0.1:8082/v1
LLM_MODEL=bartowski/Qwen2.5-3B-Instruct-GGUF:Q4_K_M
LLM_API_KEY=local
API_TIMEOUT=120
GREETING=您好，請說明要回報的維修工單。

# Local Supabase: use compose.yml + compose.supabase.yml.
# Shared development credentials below are for a local development installation.
# Keep existing credentials if your database volume has already been initialized.
VOICE_DB_PASSWORD=local-development-db-password
VOICE_JWT_SECRET=audiocpp-local-development-jwt-secret-at-least-32-bytes
VOICE_REALTIME_DB_KEY=0123456789abcdef
VOICE_REALTIME_SECRET=local-development-realtime-secret-local-development-realtime-secret
SUPABASE_API_PORT=54321
# Studio administration UI: http://LIVEKIT_NODE_IP:54323 (trusted LAN only).
# No separate dashboard login; anyone able to reach this port has admin access.
SUPABASE_STUDIO_PORT=54323
SUPABASE_STUDIO_BIND_IP=${LIVEKIT_NODE_IP}
SUPABASE_META_CRYPTO_KEY=local-development-meta-crypto-key
# Optional database-volume override. Blank preserves the existing default volume.
SUPABASE_DB_VOLUME=
SUPABASE_URL=http://127.0.0.1:${SUPABASE_API_PORT}
# Browser-reachable HTTPS URL; defaults to SUPABASE_URL. Avoid mixed HTTP on 8093.
SUPABASE_PUBLIC_URL=https://${LIVEKIT_NODE_IP}:${LIVEKIT_HTTPS_PORT}/supabase
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIiwiaWF0IjoxNzYwMDAwMDAwLCJleHAiOjIyMDAwMDAwMDB9.aYDqx9K5E9iGRWnoMu5wL-NpuYNhorMGw5TTUqImigo
# Must be signed with VOICE_JWT_SECRET. The example JWTs match the example secret.
# Server only: never put this service_role key in browser code.
SUPABASE_SECRET_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UiLCJpYXQiOjE3NjAwMDAwMDAsImV4cCI6MjIwMDAwMDAwMH0.8SwMf-vyxz0Q-ygxKu72WwMjmrFHfeJUDDSjKbK6YtU
# Supabase Edge Function produces 384-dimensional vectors using gte-small.
SUPABASE_EMBED_FUNCTION=embed
# Must match VOICE_EMBED_SECRET deployed to the Edge Function.
# If blank, the server uses SUPABASE_SECRET_KEY as the shared function secret.
SUPABASE_EMBED_SECRET=local-development-embedding-secret
