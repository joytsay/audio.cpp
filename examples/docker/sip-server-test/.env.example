# Account 520 stays on your phone. This worker registers 521 on OpenSIPS.
SIP_ACCOUNT=sip:521@175.180.90.33
SIP_PROXY=sip:175.180.90.33:9900
SIP_AUTHUSER=521
SIP_SECRET=123456
SIP_INTERFACE=wlP1p1s0
SIP_LISTEN=192.168.2.117:15061
SIP_RTP_PORTS=49160-49200
# Automatically alternate both greetings until the caller hangs up.
SIP_GREETING_LOOP=1
# Must resolve to your public IP; prefer your own DNS hostname if available.
# The mapped public SIP port is learned from the registrar's rport response.
SIP_CONTACT_HOST=175.180.90.33.nip.io
UBUNTU_VERSION=22.04
BUILD_JOBS=6

# Pause greetings during microphone activity and echo received audio.
SIP_ECHO_TEST=1
